BASE_URL=http://127.0.0.1:3000

# General execution
SCENARIO=E1
VUS=5
TOTAL_RECORDS=50
TOTAL_READS=50
TOTAL_OPERATIONS=50
MAX_DURATION=30m
SLEEP_MS=0
LOAD_TEST_RUN_ID=local-001
LOAD_TEST_ENV_FILE=results/load-test.env

# Auth. Prefer AUTH_TOKEN when a valid JWT already exists.
AUTH_TOKEN=
AUTH_EMAIL=
AUTH_PASSWORD=
DOCTOR_EMAIL=doctor_001@load.diabeteschain.local
DOCTOR_PASSWORD=
PROFESSIONAL_EMAIL=
PROFESSIONAL_PASSWORD=

# Synthetic actors used by the documented scenarios.
PATIENT_USERNAME=patient_001
PROFESSIONAL_USERNAME=doctor_001

# Scope catalog defaults seeded by the backend.
WRITE_SCOPE_ID=8f4b8d0e-2d34-4cb3-b94d-7e4c8d1a31f2
READ_SCOPE_IDS=8f4b8d0e-2d34-4cb3-b94d-7e4c8d1a31f2

# Doctor write payload. Generate a valid signature with:
# npm run setup
DOCTOR_EVENT_SIGNATURE=
WRITE_PAYLOAD_HASH=0acd7276e8195501fc24f774753bcb4236db3d3d05ed20cee8892121f76b61f2
WRITE_IV=bG9hZC10ZXN0LWl2LTEy
WRITE_AUTH_TAG=bG9hZC10ZXN0LWF1dGgtdGFn
WRITE_CIPHERTEXT=ZGlhYmV0ZXNjaGFpbi1sb2FkLXRlc3QtZW5jb3VudGVy

# Backend Fabric metrics CSV. Optional; default is load-tests/results/fabric_metrics.csv.
FABRIC_METRICS_ENABLED=true
FABRIC_METRICS_PATH=
FABRIC_EVALUATE_TIMEOUT_MS=30000
